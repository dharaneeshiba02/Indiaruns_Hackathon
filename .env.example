APP_NAME="AI Candidate Ranking System"
ENVIRONMENT=local
LOG_LEVEL=INFO

# Optional. Without this key the app uses deterministic local heuristics.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BACKEND=auto
TOP_K_FOR_LLM=20

WEIGHT_SEMANTIC=0.40
WEIGHT_SKILLS=0.20
WEIGHT_EXPERIENCE=0.15
WEIGHT_EDUCATION=0.10
WEIGHT_BEHAVIOUR=0.10
WEIGHT_ACTIVITY=0.05
